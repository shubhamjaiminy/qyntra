# Qyntra Cloud. Build: docker build -f Dockerfile.cloud -t qyntra-cloud .
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json tsconfig.cloud.json ./
COPY cloud ./cloud
COPY scripts ./scripts
RUN npx tsc -p tsconfig.cloud.json

FROM node:22-slim
ENV NODE_ENV=production PORT=8080 QYNTRA_CLOUD_DB=/data/qyntra-cloud.db
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist-cloud ./dist-cloud
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--no-warnings", "dist-cloud/cloud/server.js"]
