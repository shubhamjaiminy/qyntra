{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "outDir": "dist"
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "playwright.unit.config.ts"
  ]
}
